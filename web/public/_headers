/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' https://challenges.cloudflare.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin

# Arquivos do Vite levam o hash do conteúdo no nome: mudou, muda o nome. Podem ficar um ano no cache.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Imagens da landing (sem hash no nome): um dia no navegador e, depois disso, a cópia guardada ainda
# aparece na hora enquanto o navegador confere se mudou.
/lp/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Textos para modelos de linguagem: UTF-8 declarado (há nomes de idioma com acento) e fora do índice
# da busca, que já tem as páginas com o mesmo conteúdo.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex

# Associação com o app de iOS (links do e-mail abrem no app): a Apple lê como JSON.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
